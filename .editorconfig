root = true

# end_of_line is deliberately not set: git stores LF (see .gitattributes) and
# checks out platform-native, so pinning it here would be wrong on one platform
# or the other. Prettier is configured with endOfLine "auto" for the same reason.
[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
