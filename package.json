{
  "name": "panelingo",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that translates comics, manga and webtoons in place: on-device text detection, clean erasing and lettering, with any OpenAI-compatible vision model.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "comic",
    "manga",
    "manhwa",
    "manhua",
    "webtoon",
    "translation",
    "translator",
    "ocr",
    "scanlation",
    "onnxruntime-web",
    "webgpu",
    "openai-compatible",
    "vision-language-model",
    "ollama",
    "lm-studio",
    "typescript"
  ],
  "homepage": "https://github.com/ducdt1298/panelingo#readme",
  "bugs": {
    "url": "https://github.com/ducdt1298/panelingo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducdt1298/panelingo.git"
  },
  "license": "MIT",
  "author": "Panelingo contributors",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ducdt1298"
  },
  "type": "module",
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:test": "node scripts/build.ts --test",
    "build:prod": "node scripts/build.ts --prod",
    "package": "node scripts/build.ts --prod --out=release/dist && node scripts/package.ts release/dist",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "node scripts/typecheck.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./test/support/setup.ts --test \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node --import ./test/support/setup.ts --test \"test/unit/**/*.test.ts\"",
    "test:cov": "node --import ./test/support/setup.ts --test --experimental-test-coverage --test-coverage-include=\"src/shared/**\" --test-coverage-lines=85 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:golden:update": "node --import ./test/support/setup.ts --test --test-update-snapshots \"test/unit/**/*.test.ts\"",
    "test:e2e": "npm run build:test && node --test --test-concurrency=1 --test-timeout=180000 \"e2e/**/*.e2e.ts\"",
    "test:e2e:gpu": "npm run build:test && node e2e/run-gpu.ts",
    "fetch-models": "node scripts/fetch-models.ts",
    "eval:offline": "node tools/offline-eval/run.ts",
    "icons": "python -I -B scripts/make-icons.py",
    "fixtures": "python -I -B tools/fixtures/make_fixtures.py --out test/fixtures/generated --seed 1",
    "serve:fixtures": "node tools/fixture-server/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:cov",
    "check:full": "npm run check && npm run test:e2e",
    "test:fixtures": "python -I -B -m unittest discover -s tools/fixtures -p \"test_*.py\"",
    "mock-api": "node tools/mock-openai/cli.ts --port 4925"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/mali": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "idb": "8.0.4",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.10",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "puppeteer-core": "25.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
