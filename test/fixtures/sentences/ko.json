  "actionLines": [
    {
      "id": "a01",
      "type": "dialogue",
      "text": "거기 서!",
      "vi": "Đứng lại đó!"
    },
    {
      "id": "a02",
      "type": "dialogue",
      "text": "이번엔 못 도망가!",
      "vi": "Lần này đừng hòng chạy thoát!"
    },
    {
      "id": "a03",
      "type": "dialogue",
      "text": "고작 그게 다야?",
      "vi": "Chỉ có thế thôi sao?"
    },
    {
      "id": "a04",
      "type": "dialogue",
      "text": "물러서, 이건 내 싸움이야.",
      "vi": "Lùi lại, đây là trận đấu của tôi."
    },
    {
      "id": "a05",
      "type": "dialogue",
      "text": "후회하게 될 거다!",
      "vi": "Ngươi sẽ phải hối hận!"
    },
    {
      "id": "a06",
      "type": "dialogue",
      "text": "덤벼 봐!",
      "vi": "Xông lên đi!"
    },
    {
      "id": "a07",
      "type": "dialogue",
      "text": "어딜 도망가!",
      "vi": "Đừng hòng!"
    },
    {
      "id": "a08",
      "type": "dialogue",
      "text": "이번엔 절대 안 져!",
      "vi": "Lần này ta sẽ không thua nữa!"
    },
    {
      "id": "a09",
      "type": "sfx",
      "text": "퍽!",
      "vi": "BỐP!"
    },
    {
      "id": "a10",
      "type": "sfx",
      "text": "챙!",
      "vi": "KENG!"
    },
    {
      "id": "a11",
      "type": "sfx",
      "text": "휘익!",
      "vi": "VÚT!"
    },
    {
      "id": "a12",
      "type": "sfx",
      "text": "쿵!",
      "vi": "RẦM!"
    }
  ],
  "cast": [
    {
      "name": "하로벤",
