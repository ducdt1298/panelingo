      "name": "테오낙",
      "role": "place",
      "vi": "Teonak"
    }
  ],
  "nameLines": [
    {
      "id": "k01",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["하로벤"],
      "text": "하로벤, 또 10분이나 늦었어!",
      "canary": "10",
      "vi": "Haroben, cậu lại trễ những 10 phút!"
    },
    {
      "id": "k02",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["미루셀"],
      "text": "미안, 미루셀. 버스를 놓쳤어.",
      "vi": "Xin lỗi, Mirusel. Mình lỡ xe buýt."
    },
    {
      "id": "k03",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["하로벤"],
      "text": "하로벤은 오늘도 지각이네.",
      "vi": "Hôm nay Haroben lại đi muộn rồi."
    },
    {
      "id": "k04",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["도르카", "테오낙"],
      "text": "도르카, 테오낙 마을까지 얼마나 걸려?",
      "vi": "Dorka, đến làng Teonak mất bao lâu?"
    },
    {
      "id": "k05",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["테오낙"],
      "text": "테오낙까지는 걸어서 두 시간이야.",
      "vi": "Đi bộ đến Teonak mất hai tiếng."
    },
    {
      "id": "k06",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["미루셀"],
      "text": "미루셀, 지도는 챙겨 왔지?",
      "vi": "Mirusel, cậu mang bản đồ theo rồi chứ?"
    },
    {
      "id": "k07",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["하로벤"],
      "text": "하로벤이 챙긴다고 했잖아!",
      "vi": "Haroben bảo là tự mang mà!"
    },
    {
      "id": "k08",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["도르카"],
      "text": "도르카 말로는 다리가 무너졌대.",
      "vi": "Dorka bảo cây cầu sập rồi."
    },
    {
      "id": "k09",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["미루셀"],
      "text": "미루셀, 저 불빛 보여?",
      "vi": "Mirusel, thấy ánh đèn kia không?"
    },
    {
      "id": "k10",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["테오낙"],
      "text": "저기가 테오낙 시장이야.",
      "vi": "Đằng kia là chợ Teonak đấy."
    },
    {
      "id": "k11",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["도르카"],
      "text": "도르카, 우산 하나 더 있어?",
      "vi": "Dorka, cậu còn cái ô nào nữa không?"
    },
    {
      "id": "k12",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["하로벤"],
      "text": "하로벤, 너는 늘 준비가 부족해.",
      "vi": "Haroben, cậu lúc nào cũng thiếu chuẩn bị."
    },
    {
      "id": "k13",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["테오낙"],
      "text": "내일은 테오낙 축제 날이야.",
      "vi": "Mai là ngày lễ hội Teonak."
    },
    {
      "id": "k14",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["미루셀"],
      "text": "미루셀, 축제에 같이 갈래?",
      "vi": "Mirusel, đi lễ hội cùng mình không?"
    },
    {
      "id": "k15",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["하로벤", "미루셀"],
      "text": "하로벤이랑 미루셀은 먼저 가.",
      "vi": "Haroben với Mirusel đi trước đi."
    },
    {
      "id": "k16",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["도르카"],
      "text": "도르카, 3시에 광장에서 보자.",
      "canary": "3",
      "vi": "Dorka, 3 giờ gặp ở quảng trường nhé."
    },
    {
      "id": "k17",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["미루셀"],
      "text": "미루셀, 이 편지 네 거야?",
      "vi": "Mirusel, lá thư này của cậu à?"
    },
    {
      "id": "k18",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["하로벤"],
      "text": "하로벤, 그거 열어 보지 마!",
      "vi": "Haroben, đừng mở nó ra!"
    },
    {
      "id": "k19",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["테오낙"],
      "text": "테오낙에 비가 온다던데.",
      "vi": "Nghe nói ở Teonak đang mưa."
    },
    {
      "id": "k20",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["도르카"],
      "text": "도르카, 오늘 정말 고마웠어.",
      "vi": "Dorka, hôm nay cảm ơn cậu nhiều lắm."
    },
    {
      "id": "k21",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["하로벤"],
      "text": "하로벤, 내 가방 못 봤어?",
      "vi": "Haroben, cậu có thấy túi của mình đâu không?"
    },
    {
      "id": "k22",
      "type": "dialogue",
      "speaker": "도르카",
      "names": ["미루셀"],
      "text": "미루셀 가방은 의자 밑에 있어.",
      "vi": "Túi của Mirusel ở dưới ghế ấy."
    },
    {
      "id": "k23",
      "type": "dialogue",
      "speaker": "하로벤",
      "names": ["테오낙"],
      "text": "테오낙 다리 앞에서 기다릴게.",
      "vi": "Mình sẽ đợi trước cầu Teonak."
    },
    {
      "id": "k24",
      "type": "dialogue",
      "speaker": "미루셀",
      "names": ["도르카"],
      "text": "도르카는 벌써 출발했대.",
      "vi": "Nghe nói Dorka đi trước rồi."
    },
    {
      "id": "k25",
      "type": "narration",
      "speaker": null,
      "names": ["테오낙"],
      "text": "다음 날, 테오낙",
      "vi": "Ngày hôm sau, Teonak"
    },
    {
      "id": "k26",
      "type": "narration",
      "speaker": null,
      "names": ["테오낙"],
      "text": "테오낙 축제 첫날",
      "vi": "Ngày đầu tiên của lễ hội Teonak"
    }
  ]
}
