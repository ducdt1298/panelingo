  "nameLines": [
    {
      "id": "z01",
      "type": "dialogue",
      "speaker": "钟岚溪",
      "names": ["易墨川"],
      "text": "易墨川，你又迟到了20分钟！",
      "canary": "20",
      "vi": "Dịch Mặc Xuyên, cậu lại đến muộn 20 phút!"
    },
    {
      "id": "z02",
      "type": "dialogue",
      "speaker": "易墨川",
      "names": ["岚溪"],
      "text": "对不起，岚溪。路上堵车了。",
      "vi": "Xin lỗi, Lam Khê. Đường bị kẹt xe."
    },
    {
      "id": "z03",
      "type": "dialogue",
      "speaker": "钟岚溪",
      "names": ["墨川"],
      "text": "墨川，你的伞忘在车上了。",
      "vi": "Mặc Xuyên, cậu để quên ô trên xe rồi."
    },
    {
      "id": "z04",
      "type": "dialogue",
      "speaker": "易墨川",
      "names": ["钟岚溪"],
      "text": "钟岚溪，帮我拿一下钥匙。",
      "vi": "Chung Lam Khê, cầm hộ mình chùm chìa khóa với."
    },
    {
      "id": "z05",
      "type": "dialogue",
      "speaker": "钟岚溪",
      "names": ["易墨川"],
      "text": "易墨川总是丢三落四的。",
      "vi": "Dịch Mặc Xuyên lúc nào cũng quên trước quên sau."
    },
    {
      "id": "z06",
      "type": "dialogue",
      "speaker": "易墨川",
      "names": ["岚溪"],
      "text": "岚溪，明天一起去图书馆吧。",
      "vi": "Lam Khê, mai cùng đi thư viện nhé."
    },
    {
      "id": "z07",
      "type": "dialogue",
      "speaker": "钟岚溪",
      "names": ["墨川"],
      "text": "好啊，墨川，九点见。",
      "vi": "Được thôi, Mặc Xuyên, chín giờ gặp nhé."
    },
    {
      "id": "z08",
      "type": "dialogue",
      "speaker": "易墨川",
      "names": ["钟岚溪"],
      "text": "钟岚溪，外面下雪了！",
      "vi": "Chung Lam Khê, ngoài trời có tuyết rơi kìa!"
    }
  ]
