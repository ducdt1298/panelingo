  "actionLines": [
    {
      "id": "a01",
      "type": "dialogue",
      "text": "站住！",
      "vi": "Đứng lại đó!"
    },
    {
      "id": "a02",
      "type": "dialogue",
      "text": "这次你跑不掉了！",
      "vi": "Lần này đừng hòng chạy thoát!"
    },
    {
      "id": "a03",
      "type": "dialogue",
      "text": "就这点本事吗？",
      "vi": "Chỉ có thế thôi sao?"
    },
    {
      "id": "a04",
      "type": "dialogue",
      "text": "退后，这是我的战斗。",
      "vi": "Lùi lại, đây là trận đấu của tôi."
    },
    {
      "id": "a05",
      "type": "dialogue",
      "text": "你会后悔的！",
      "vi": "Ngươi sẽ phải hối hận!"
    },
    {
      "id": "a06",
      "type": "dialogue",
      "text": "放马过来！",
      "vi": "Xông lên đi!"
    },
    {
      "id": "a07",
      "type": "dialogue",
      "text": "想跑？没门！",
      "vi": "Đừng hòng!"
    },
    {
      "id": "a08",
      "type": "dialogue",
      "text": "我不会再输给你了！",
      "vi": "Lần này ta sẽ không thua nữa!"
    },
    {
      "id": "a09",
      "type": "sfx",
      "text": "啪！",
      "vi": "BỐP!"
    },
    {
      "id": "a10",
      "type": "sfx",
      "text": "锵！",
      "vi": "KENG!"
    },
    {
      "id": "a11",
      "type": "sfx",
      "text": "嗖！",
      "vi": "VÚT!"
    },
    {
      "id": "a12",
      "type": "sfx",
      "text": "咚！",
      "vi": "RẦM!"
    }
  ],
